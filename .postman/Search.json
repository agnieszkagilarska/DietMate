                  {
                    "key": "offset",
                    "value": "0"
                  }
                ]
              },
              "description": "Wyszukuje produkty pełnoziarniste w koszyku"
            },
            "response": []
          }
        ],
        "description": "Demonstracja możliwości wyszukiwania w koszyku z wykorzystaniem indeksu Redis Stack"
      },
      {
        "name": "4. Finalizacja koszyka",
        "item": [
          {
            "name": "Opróżnij koszyk (zamówienie złożone)",
            "request": {
              "method": "DELETE",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}",
                  "type": "text"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n    \"values\": [\n        \"Oliwa z oliwek extra virgin 500ml\",\n        \"Jogurt grecki naturalny 400g\",\n        \"Chleb pełnoziarnisty 500g\",\n        \"Pomidory malinowe 500g\",\n        \"Ogórki świeże 500g\",\n        \"Ser feta 200g\",\n        \"Oliwki czarne bez pestek 200g\",\n        \"Makaron pełnoziarnisty 400g\",\n        \"Tuńczyk w oliwie z oliwek 150g\",\n        \"Olej kokosowy extra virgin 250ml\"\n    ]\n}"
              },
              "url": {
                "raw": "{{base_url}}/api/redis/bulk-delete?set_name=shopping_cart",
                "host": ["{{base_url}}"],
                "path": ["api", "redis", "bulk-delete"],
                "query": [
                  {
                    "key": "set_name",
                    "value": "shopping_cart"
                  }
                ]
              },
              "description": "Usuwa wszystkie produkty z koszyka (np. po złożeniu zamówienia)"
            },
            "response": []
          },
          {
            "name": "Sprawdź czy koszyk jest pusty",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{token}}",
                  "type": "text"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/redis/list?set_name=shopping_cart",
                "host": ["{{base_url}}"],
                "path": ["api", "redis", "list"],
                "query": [
                  {
                    "key": "set_name",
                    "value": "shopping_cart"
                  }
                ]
