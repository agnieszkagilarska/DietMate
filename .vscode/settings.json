{
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe"
    }
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "server",
          "commands": [
            "cd backend",
            "[ \"$(uname)\" = \"Darwin\" ] && (test -d venv || python3 -m venv venv) || (test -d venv || py -m venv venv)",
            "[ \"$(uname)\" = \"Darwin\" ] && source venv/bin/activate || source venv/Scripts/activate",
            "poetry install",
            "[ \"$(uname)\" = \"Darwin\" ] && python3 local.py || py local.py"
          ]
        },
        {
          "name": "client",
          "commands": [
            "cd frontend", 
            "npm install", 
            "npm start"
          ]
        }
      ]
    }
  ]
}